{
  "name": "haven-nyx-preview",
  "private": true,
  "scripts": {
    "build": "node haven/build.mjs",
    "history:preview": "node haven/import/preview.mjs",
    "chat:memory-lab": "node haven/build.mjs && node haven/gateway/server.mjs --memory-lab",
    "chat:provider-lab": "node haven/build.mjs && node --env-file-if-exists=.haven-local/embedding.env haven/gateway/server.mjs --provider-lab",
    "chat:api-trial": "node --env-file-if-exists=.haven-local/provider-trial.env haven/gateway/gemini-trial.mjs",
    "chat:api-trial-ui": "node --env-file-if-exists=.haven-local/provider-trial.env haven/gateway/gemini-trial-server.mjs",
    "chat:live-lab": "node haven/build.mjs && node --env-file-if-exists=.haven-local/embedding.env --env-file-if-exists=.haven-local/provider-trial.env haven/gateway/server.mjs --live-lab",
    "chat:local": "node haven/build.mjs && node --env-file-if-exists=.haven-local/embedding.env haven/gateway/server.mjs"
  }
}
